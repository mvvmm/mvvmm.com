---
import FaviconCanvas from "@/components/FaviconCanvas";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "mvm", description = "Generated by mvm" } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-black text-gray-100 text-[20px]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <FaviconCanvas client:load />
    <slot />
  </body>
</html>
